-- Q10
SELECT c.course_no, c.course_name, COUNT(*) AS student_count
FROM student s, course_taken ct, course c
WHERE s.prospectus_no = ct.prospectus_no
AND ct.course_no = c.course_no
AND TRUNC(s.d_o_b,'MM') = TRUNC(SYSDATE,'MM')
GROUP BY c.course_no, c.course_name
HAVING COUNT(*) =
(
    SELECT MAX(student_count)
    FROM
    (
        SELECT ct.course_no,
               COUNT(*) AS student_count
        FROM student s, course_taken ct
        WHERE s.prospectus_no = ct.prospectus_no
        AND TRUNC(s.d_o_b,'MM') = TRUNC(SYSDATE,'MM')
        GROUP BY ct.course_no
    )
);
CREATE TABLE course
(
    course_no   CHAR(4) PRIMARY KEY,
    course_name VARCHAR2(20)
);
CREATE TABLE course_fee
(
    course_no CHAR(4) PRIMARY KEY,
    full_part CHAR(1),
    fees      NUMBER(10)
);
CREATE TABLE student
(
    prospectus_no NUMBER(10) PRIMARY KEY,
    name          VARCHAR2(20),
    address       VARCHAR2(30),
    phone_no      NUMBER(11),
    d_o_b         DATE,
    total_amnt    NUMBER(10,2),
    amnt_paid     NUMBER(10,2),
    installment   CHAR(1)
);
CREATE TABLE installment
(
    prospectus_no   NUMBER(10),
    installment_amnt NUMBER(10,2),
    due_dt          DATE,
    paid            CHAR(1),
    CONSTRAINT fk_installment_student
    FOREIGN KEY (prospectus_no)
    REFERENCES student(prospectus_no)
);
CREATE TABLE course_taken
(
    prospectus_no NUMBER(10),
    course_no     VARCHAR2(4),
    start_dt      DATE,
    full_part     CHAR(1),
    time_slot     CHAR(2),
    performance   VARCHAR2(20),
    CONSTRAINT fk_course_taken_student
    FOREIGN KEY (prospectus_no)
    REFERENCES student(prospectus_no)
);
