
-- Q1
SELECT s.name, c.course_no
FROM student s, course_taken c
WHERE s.prospectus_no = c.prospectus_no;


-- Q2
SELECT name
FROM student
WHERE amnt_paid = total_amnt;


-- Q3
SELECT name
FROM student
WHERE name LIKE 'A%';


-- Q4
SELECT s.name
FROM student s, installment i
WHERE s.prospectus_no = i.prospectus_no
AND s.total_amnt <> i.installment_amnt;


-- Q5
SELECT COUNT(*) AS student_count
FROM student
WHERE TRUNC(d_o_b,'MM') = TRUNC(SYSDATE,'MM');


-- Q6
SELECT MAX(fees) AS maximum_fee,
       MIN(fees) AS minimum_fee
FROM course_fee;


-- Q7
SELECT c.course_no, c.course_name,
       f.full_part, f.fees
FROM course c, course_fee f
WHERE c.course_no = f.course_no
AND f.fees BETWEEN 5000 AND 10000;


-- Q8
SELECT name,
       TO_CHAR(d_o_b,'DD FMMonth YYYY') AS admission_date
FROM student;


